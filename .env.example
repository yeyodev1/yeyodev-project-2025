# GitHub API token (optional but recommended)
# Without token: 60 requests/hour (unauthenticated)
# With token:    5,000 requests/hour
#
# Create one at: https://github.com/settings/tokens
# Only needs "public_repo" read scope (or no scope for public data)
#
# Copy this file to .env.local and fill in your token:
VITE_GITHUB_TOKEN=your_github_token_here

# Contact form webhook — Lead registration (LeadConnectorHQ / GoHighLevel)
# Data is POSTed here as JSON when a visitor submits the contact form
VITE_CONTACT_WEBHOOK=https://services.leadconnectorhq.com/hooks/YOUR_LOCATION_ID/webhook-trigger/YOUR_CONTACT_TRIGGER_ID

# Contact form webhook — Lead qualification (LeadConnectorHQ / GoHighLevel)
# Receives additional qualification data + notes + tags
VITE_QUALIFICATION_WEBHOOK=https://services.leadconnectorhq.com/hooks/YOUR_LOCATION_ID/webhook-trigger/YOUR_QUALIFICATION_TRIGGER_ID
